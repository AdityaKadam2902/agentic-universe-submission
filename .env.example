# Agentic Universe Assignment A — environment configuration template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Required: Fernet key for PII encryption (32-byte URL-safe base64).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Required: high-entropy secret used for HMAC-SHA256 phone matching
# (workflow-scoped). Must be different from ENCRYPTION_KEY.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
HMAC_KEY=

# Optional: database file location (default: agentic_universe.db)
# DB_PATH=agentic_universe.db

# Optional: default data directory (default: data)
# DATA_PATH=data
